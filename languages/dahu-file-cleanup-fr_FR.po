msgstr "planification"

#: includes/class-dahu-file-cleanup-paths.php:115
msgid "that is a structural folder of the site (the WordPress root, wp-content or the uploads root): target a specific subfolder instead"
msgstr "c’est un dossier structurel du site (la racine WordPress, wp-content ou la racine d’uploads) : visez plutôt un sous-dossier précis"

#. translators: %s: name of a WordPress directory, e.g. "plugins". */
#: includes/class-dahu-file-cleanup-paths.php:105
msgid "that path is inside the %s folder, which this plugin never deletes from"
msgstr "ce chemin est dans le dossier %s, dont cette extension ne supprime jamais rien"

#: includes/class-dahu-file-cleanup-admin.php:1020
msgid "the ceiling was reached; the rest goes on the next run"
msgstr "le plafond a été atteint ; le reste passe à l’exécution suivante"

#: includes/class-dahu-file-cleanup-paths.php:53
msgid "the path contains a null byte"
msgstr "le chemin contient un octet nul"

#: includes/class-dahu-file-cleanup-paths.php:85
msgid "the resolved path is outside this site: it is not under the WordPress root, wp-content or the uploads folder"
msgstr "le chemin résolu sort du site : il n’est ni sous la racine WordPress, ni sous wp-content, ni sous le dossier d’uploads"

#: includes/class-dahu-file-cleanup-rules.php:336
msgid "the rule has no name"
msgstr "la règle n’a pas de nom"

#: includes/class-dahu-file-cleanup-paths.php:73
msgid "the target is not a folder"
msgstr "la cible n’est pas un dossier"

#: includes/class-dahu-file-cleanup-rules.php:269
msgid "too long to be a file extension"
msgstr "trop long pour être une extension de fichier"

#: includes/class-dahu-file-cleanup-paths.php:57
msgid "wildcards (* ?) are not allowed: a rule targets a folder, and selects files by extension"
msgstr "les jokers (* ?) sont interdits : une règle vise un dossier, et sélectionne les fichiers par extension"

#. translators: %s: number of further files. */
#: includes/class-dahu-file-cleanup-admin.php:960
msgid "… and %s more, not listed"
msgstr "… et %s de plus, non listés"

